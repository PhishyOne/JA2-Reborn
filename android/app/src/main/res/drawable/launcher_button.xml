<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape>
            <solid android:color="#C82F2A24" />
            <corners android:radius="8dp" />
            <stroke
                android:width="1dp"
                android:color="#D8B56B3A" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="#A927211C" />
            <corners android:radius="8dp" />
            <stroke
                android:width="1dp"
                android:color="#B88A5632" />
        </shape>
    </item>
</selector>
