<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape>
            <gradient
                android:startColor="#B95B2118"
                android:endColor="#E08C3F25"
                android:angle="0" />
            <corners android:radius="8dp" />
            <stroke
                android:width="1dp"
                android:color="#FFFFC17A" />
        </shape>
    </item>
    <item>
        <shape>
            <gradient
                android:startColor="#D96E2B1F"
                android:endColor="#F2A64A26"
                android:angle="0" />
            <corners android:radius="8dp" />
            <stroke
                android:width="1dp"
                android:color="#FFFFD59B" />
        </shape>
    </item>
</selector>
