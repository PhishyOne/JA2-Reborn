<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/constraintLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:paddingBottom="10dp"
    tools:context=".ui.main.SettingsFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:orientation="horizontal"
        android:padding="2dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="12dp"
            android:layout_weight="1"
            android:background="@drawable/launcher_panel"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:id="@+id/resolutionInfoTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/resolution_info_title_text"
                android:textColor="#FFFFF3E6"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/resolutionInfoText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/resolution_info_text"
                android:textColor="#DDE7D6C4"
                android:textSize="14sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="14dp"
                android:baselineAligned="false"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/resolutionWidthEdit"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/launcher_surface"
                    android:gravity="center"
                    android:inputType="number"
                    android:maxLines="1"
                    android:textColor="#FFF3E6D7"
                    android:textColorHint="#99FFF3E6" />

                <TextView
                    android:id="@+id/resolutionXText"
                    android:layout_width="32dp"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="x"
                    android:textColor="#DDE7D6C4"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/resolutionHeightEdit"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/launcher_surface"
                    android:gravity="center"
                    android:inputType="number"
                    android:maxLines="1"
                    android:textColor="#FFF3E6D7"
                    android:textColorHint="#99FFF3E6" />

                <Button
                    android:id="@+id/resolutionAutoButton"
                    android:layout_width="128dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="12dp"
                    android:background="@drawable/launcher_button"
                    android:maxLines="1"
                    android:text="@string/resolution_auto_button"
                    android:textAllCaps="false"
                    android:textColor="#FFFFF3E6" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:layout_weight="1"
            android:background="@drawable/launcher_panel"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:id="@+id/scalingQualityInfoTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/scaling_quality_info_title_text"
                android:textColor="#FFFFF3E6"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/scalingQualityInfoText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/scaling_quality_info_text"
                android:textColor="#DDE7D6C4"
                android:textSize="14sp" />

            <Spinner
                android:id="@+id/scalingQualitySpinner"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/launcher_surface"
                android:contentDescription="@string/game_version_empty_text"
                android:paddingStart="10dp"
                android:paddingEnd="10dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:background="@drawable/launcher_panel"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:id="@+id/mouseModeInfoTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/mouse_mode_info_title_text"
                android:textColor="#FFFFF3E6"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/mouseModeInfoText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/mouse_mode_info_text"
                android:textColor="#DDE7D6C4"
                android:textSize="14sp" />

            <Spinner
                android:id="@+id/mouseModeSpinner"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/launcher_surface"
                android:contentDescription="@string/mouse_mode_info_title_text"
                android:paddingStart="10dp"
                android:paddingEnd="10dp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
